<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup><ItemGroup><ProjectReference Include="../CombatCore/CombatCore.csproj" />
    <!-- The player-facing strings live in the Unity folder but have no UnityEngine dependency,
         so they can be checked for gaps here. -->
    <Compile Include="../../game/Assets/Scripts/Texts.cs" />
    <!-- The tutorial decides when each lesson fires. That is only worth having if it can be
         run without the editor, so it has no UnityEngine dependency either. -->
    <Compile Include="../../game/Assets/Scripts/Coach.cs" />
    <!-- When to retry an upload and when to stop is wrong for months if it cannot be run
         without the editor, so it has no UnityEngine dependency either. -->
    <Compile Include="../../game/Assets/Scripts/RunOutbox.cs" />
    <!-- Merging inputs and knowing when to give up on a tape is wrong for months if it cannot be
         run without the editor. -->
    <Compile Include="../../game/Assets/Scripts/RunTape.cs" />
    <!-- The fixed fight whose transcript the editor and a device are compared against. -->
    <Compile Include="../../game/Assets/Scripts/DeterminismProbe.cs" /></ItemGroup></Project>
